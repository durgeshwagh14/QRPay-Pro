# Server Configuration
PORT=5000
NODE_ENV=development

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/qrpay-pro
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=super_secret_jwt_access_token_key_12345
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_12345
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Third-party Services (Optional/Required for certain features)
# Cloudinary (for file/logo upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (for subscriptions/gateway payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP Server (for emails/OTP, falls back to console if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@qrpaypro.com

# Client
CLIENT_URL=http://localhost:5173
